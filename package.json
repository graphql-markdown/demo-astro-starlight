{
  "name": "starlight",
  "type": "module",
  "version": "1.34.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node -e \"require('node:fs').cpSync('.markdown-copies','dist',{recursive:true})\"",
    "preview": "astro preview",
    "test:visual": "playwright test",
    "astro": "astro",
    "doc": "gqlmd graphql-to-doc && gqlmd graphql-to-doc:markdown",
    "gqlmd": "gqlmd",
    "postinstall": "npm run doc"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@catppuccin/starlight": "^2.1.0",
    "@graphql-markdown/cli": "^1.3.1",
    "@graphql-markdown/formatters": "^1.3.1",
    "@graphql-markdown/graphql": "^1.4.1",
    "@graphql-markdown/printer-legacy": "^1.21.1",
    "@graphql-tools/url-loader": "^10.0.9",
    "astro": "^7.4.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.0",
    "@playwright/test": "^1.65.1",
    "serve": "^14.2.8"
  }
}
