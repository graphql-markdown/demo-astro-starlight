---
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default><slot /></Default>
<p class="gqlmd-footer">
  Generated with <a href="https://graphql-markdown.dev">GraphQL-Markdown</a>{" · "}<a href="https://github.com/graphql-markdown/graphql-markdown">⭐ Star on GitHub</a>
</p>

<style>
  .gqlmd-footer {
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
  .gqlmd-footer a {
    color: var(--sl-color-text-accent);
  }
</style>

<style is:global>
  /* Keep the footer at the bottom of the viewport on short pages. */
  .main-pane > main {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
  }
  .main-pane > main > .content-panel:last-child,
  .main-pane > main > .content-panel:last-child > .sl-container {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .main-pane > main > .content-panel:last-child > .sl-container {
    width: 100%;
  }
  .main-pane > main > .content-panel:last-child > .sl-container > :has(+ footer) {
    flex-grow: 1;
  }
</style>
